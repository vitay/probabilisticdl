@article{Luque2012,
  title = {From Sensors to Spikes: Evolving Receptive Fields to Enhance Sensorimotor Information in a Robot-Arm.},
  author = {Luque, Niceto R and Garrido, Jes{\'u}s A and Ralli, Jarno and Laredo, Juanlu J and Ros, Eduardo},
