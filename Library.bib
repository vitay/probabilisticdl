@article{Kaufman2020,
  title = {A {{Role}} for the {{Locus Coeruleus}} in {{Hippocampal CA1 Place Cell Reorganization}} during {{Spatial Reward Learning}}},
  author = {Kaufman, Alexandra Mansell and Geiller, Tristan and Losonczy, Attila},
  year = 2020,
