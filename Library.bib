@article{Sanz-Leon2015,
  title = {Mathematical Framework for Large-Scale Brain Network Modeling in {{The Virtual Brain}}},
  author = {{Sanz-Leon}, Paula and Knock, Stuart A. and Spiegler, Andreas and Jirsa, Viktor K.},
  year = 2015,
  month = may,
  journal = {NeuroImage},
  volume = {111},
  pages = {385--430},
