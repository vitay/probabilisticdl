@article{Maia2017,
  title = {The {{Roles}} of {{Phasic}} and {{Tonic Dopamine}} in {{Tic~Learning}} and {{Expression}}},
  author = {Maia, Tiago V. and Concei{\c c}{\~a}o, Vasco A.},
  year = 2017,
  month = sep,
  journal = {Biological Psychiatry},
