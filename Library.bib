@article{Lowet2020,
  title = {Distributional {{Reinforcement Learning}} in the {{Brain}}},
  author = {Lowet, Adam S. and Zheng, Qiao and Matias, Sara and Drugowitsch, Jan and Uchida, Naoshige},
  year = 2020,
