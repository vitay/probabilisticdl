@article{Foo2021,
  title = {Reinforcement Learning Links Spontaneous Cortical Dopamine Impulses to Reward},
  author = {Foo, Conrad and Lozada, Adrian and Aljadeff, Johnatan and Li, Yulong and Wang, Jing W. and Slesinger, Paul A. and Kleinfeld, David},
