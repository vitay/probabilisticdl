@article{Masse2019,
  title = {Circuit Mechanisms for the Maintenance and Manipulation of Information in Working Memory},
  author = {Masse, Nicolas Y. and Yang, Guangyu R. and Song, H. Francis and Wang, Xiao-Jing and Freedman, David J.},
  year = 2019,
