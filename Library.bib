@article{Hamker2005c,
  ids = {Hamker2005a},
  title = {The {{Reentry Hypothesis}}: {{The Putative Interaction}} of the {{Frontal Eye Field}}, {{Ventrolateral Prefrontal Cortex}}, and {{Areas V4}}, {{IT}} for {{Attention}} and {{Eye Movement}}},
