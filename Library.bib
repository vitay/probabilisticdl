  author = {Neumann, Wolf-Julian and Schroll, Henning and {de Almeida Marcelino}, Ana Luisa and Horn, Andreas and Ewert, Siobhan and Irmen, Friederike and Krause, Patricia and Schneider, Gerd-Helge and Hamker, Fred and K{\"u}hn, Andrea A},
  year = 2018,
