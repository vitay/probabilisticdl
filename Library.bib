  author = {Li, Hao and Namburi, Praneeth and Olson, Jacob M. and Borio, Matilde and Lemieux, Mackenzie E. and Beyeler, Anna and Calhoon, Gwendolyn G. and {Hitora-Imamura}, Natsuko and Coley, Austin A. and Libster, Avraham and Bal, Aneesh and Jin, Xin and Wang, Huan and Jia, Caroline and Choudhury, Sourav R. and Shi, Xi and {Felix-Ortiz}, Ada C. and {de la Fuente}, Ver{\'o}nica and Barth, Vanessa P. and King, Hunter O. and Izadmehr, Ehsan M. and Revanna, Jasmin S. and Batra, Kanha and Fischer, Kyle B. and Keyes, Laurel R. and {Padilla-Coreano}, Nancy and Siciliano, Cody A. and McCullough, Kenneth M. and Wichmann, Romy and Ressler, Kerry J. and Fiete, Ila R. and Zhang, Feng and Li, Yulong and Tye, Kay M.},
  year = 2022,
