@article{Wilhelm2023,
  title = {Striatum-Projecting Prefrontal Cortex Neurons Support Working Memory Maintenance},
  author = {Wilhelm, Maria and Sych, Yaroslav and Fomins, Aleksejs and Alatorre Warren, Jos{\'e} Luis and Lewis, Christopher and Serratosa Capdevila, Laia and Boehringer, Roman and Amadei, Elizabeth A. and Grewe, Benjamin and O'Connor, Eoin C. and Hall, Benjamin J. and Helmchen, Fritjof},
