}

@article{Hanocka2019,
  title = {{{MeshCNN}}: A Network with an Edge},
  shorttitle = {{{MeshCNN}}},
  author = {Hanocka, Rana and Hertz, Amir and Fish, Noa and Giryes, Raja and Fleishman, Shachar and {Cohen-Or}, Daniel},
