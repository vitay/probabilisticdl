@article{Gardner2018,
  title = {Rethinking Dopamine as Generalized Prediction Error},
  author = {Gardner, Matthew P. H. and Schoenbaum, Geoffrey and Gershman, Samuel J.},
  year = 2018,
  month = nov,
  journal = {Proceedings of the Royal Society B: Biological Sciences},
  volume = {285},
  number = {1891},
