@article{Gonner2017,
  title = {Predictive {{Place-Cell Sequences}} for {{Goal-Finding Emerge}} from {{Goal Memory}} and the {{Cognitive Map}}: {{A Computational Model}}},
  author = {G{\"o}nner, Lorenz and Vitay, Julien and Hamker, Fred H.},
