  publisher = {Cold Spring Harbor Laboratory},
  doi = {10.1101/2020.05.20.100065},
  urldate = {2020-05-29},
  abstract = {{$<$}p{$>$}Reward expectations based on internal knowledge of the external environment are a core component of adaptive behavior. However, internal knowledge may be inaccurate or incomplete due to errors in sensory measurements. Some features of the environment may also be encoded inaccurately to minimise representational costs associated with their processing. We investigate how reward expectations are affected by differences in internal representations by studying rodents9 behaviour and dopaminergic activity while they make time based decisions. Several possible representations allow a reinforcement learning agent to model animals9 choices during the task. However, only a small subset of highly compressed representations simultaneously reproduce, both, animals9 behaviour and dopaminergic activity. Strikingly, these representations predict an unusual distribution of response times that closely matches animals9 behaviour. These results can inform how constraints of representational efficiency may be expressed in encoding representations of dynamic cognitive variables used for reward based computations.{$<$}/p{$>$}},
  chapter = {New Results},
  copyright = {\copyright{} 2020, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution-NonCommercial-NoDerivs 4.0 International), CC BY-NC-ND 4.0, as described at http://creativecommons.org/licenses/by-nc-nd/4.0/},
  langid = {english},
  file = {/Users/vitay/Documents/Zotero/storage/BZJ2MLZF/Motiwala_et_al_2020_Dopamine_responses_reveal_efficient_coding_of_cognitive_variables.pdf;/Users/vitay/Documents/Zotero/storage/D3YAAV5L/2020.05.20.100065v1.html}
}

