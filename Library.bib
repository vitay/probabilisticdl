@article{Kojima1982,
  title = {Delay-Related Activity of Prefrontal Neurons in Rhesus Monkeys Performing Delayed Response.},
  author = {Kojima, S and {Goldman-Rakic}, P S},
  year = 1982,
  month = sep,
  journal = {Brain research},
  volume = {248},
