  shorttitle = {Multisensory Responses and Receptive Field Properties of Neurons in the Substantia Nigra and in the Caudate Nucleus},
  author = {Nagy, Attila and Par{\'o}czy, Zsuzsanna and Norita, Masao and Benedek, Gy{\"o}rgy},
