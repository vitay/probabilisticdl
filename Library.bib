@article{Xu2022,
  title = {A {{Brain-Inspired Model}} of {{Hippocampal Spatial Cognition Based}} on a {{Memory-Replay Mechanism}}},
  author = {Xu, Runyu and Ruan, Xiaogang and Huang, Jing},
