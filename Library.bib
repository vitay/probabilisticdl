@article{Houk2007,
  title = {Action Selection and Refinement in Subcortical Loops through Basal Ganglia and Cerebellum.},
  author = {Houk, J C and Bastianen, C and Fansler, D and Fishbach, A and Fraser, D and Reber, P J and Roy, S A and Simo, L S},
  year = 2007,
  month = sep,
  journal = {Philos. Trans. R. Soc. Lond. B. Biol. Sci.},
  volume = {362},
