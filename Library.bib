@article{Blockley2014,
  title = {Recent Development of the {{Met Office}} Operational Ocean Forecasting System: An Overview and Assessment of the New {{Global FOAM}} Forecasts},
  shorttitle = {Recent Development of the {{Met Office}} Operational Ocean Forecasting System},
  author = {Blockley, E. W. and Martin, M. J. and McLaren, A. J. and Ryan, A. G. and Waters, J. and Lea, D. J. and Mirouze, I. and Peterson, K. A. and Sellar, A. and Storkey, D.},
  year = 2014,
  month = nov,
  journal = {Geoscientific Model Development},
  volume = {7},
  number = {6},
  pages = {2613--2638},
  publisher = {Copernicus GmbH},
  issn = {1991-959X},
  doi = {10.5194/gmd-7-2613-2014},
  urldate = {2026-04-27},
  abstract = {The Forecast Ocean Assimilation Model (FOAM) is an operational ocean analysis and forecast system run daily at the Met Office. FOAM provides modelling capability in both deep ocean and coastal shelf sea regimes using the NEMO (Nucleus for European Modelling of the Ocean) ocean model as its dynamical core. The FOAM Deep Ocean suite produces analyses and 7-day forecasts of ocean tracers, currents and sea ice for the global ocean at 1/4{$^\circ$} resolution. Satellite and in situ observations of temperature, salinity, sea level anomaly and sea ice concentration are assimilated by FOAM each day over a 48 h observation window. The FOAM Deep Ocean configurations have recently undergone a major upgrade which has involved the implementation of a new variational, first guess at appropriate time (FGAT) 3D-Var, assimilation scheme (NEMOVAR); coupling to a different, multi-thickness-category, sea ice model (CICE); the use of coordinated ocean-ice reference experiment (CORE) bulk formulae to specify the surface boundary condition; and an increased vertical resolution for the global model.   In this paper the new FOAM Deep Ocean system is introduced and details of the recent changes are provided. Results are presented from 2-year reanalysis integrations of the Global FOAM configuration including an assessment of short-range ocean forecast accuracy. Comparisons are made with both the previous FOAM system and a non-assimilative FOAM system. Assessments reveal considerable improvements in the new system to the near-surface ocean and sea ice fields. However there is some degradation to sub-surface tracer fields and in equatorial regions which highlights specific areas upon which to focus future improvements.},
  langid = {english},
  file = {/Users/vitay/Documents/Zotero/storage/N7M6GXC7/Blockley et al. - 2014 - Recent development of the Met Office operational ocean forecasting system an overview and assessmen.pdf}
}

@misc{Blundell2016,
  title = {Model-{{Free Episodic Control}}},
  author = {Blundell, Charles and Uria, Benigno and Pritzel, Alexander and Li, Yazhe and Ruderman, Avraham and Leibo, Joel Z. and Rae, Jack and Wierstra, Daan and Hassabis, Demis},
  year = 2016,
  month = jun,
