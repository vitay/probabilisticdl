@article{Mannella2018,
  title = {Know {{Your Body Through Intrinsic Goals}}},
  author = {Mannella, Francesco and Santucci, Vieri G. and Somogyi, Eszter and Jacquey, Lisa and O'Regan, Kevin J. and Baldassarre, Gianluca},
  year = 2018,
  month = jul,
  journal = {Frontiers in Neurorobotics},
  volume = {12},
