  author = {Qin, Shaoxiang and Lyu, Fuyuan and Peng, Wenhui and Geng, Dingyang and Wang, Ju and Tang, Xing and Leroyer, Sylvie and Gao, Naiping and Liu, Xue and Wang, Liangzhu Leon},
