  booktitle = {Neural {{Information Processing}}},
  author = {Guo, Xifeng and Liu, Xinwang and Zhu, En and Yin, Jianping},
  editor = {Liu, Derong and Xie, Shengli and Li, Yuanqing and Zhao, Dongbin and {El-Alfy}, El-Sayed M.},
  year = 2017,
