  author = {Hamid, Arif A. and Pettibone, Jeffrey R. and Mabrouk, Omar S. and Hetrick, Vaughn L. and Schmidt, Robert and Vander Weele, Caitlin M. and Kennedy, Robert T. and Aragona, Brandon J. and Berke, Joshua D.},
  year = 2016,
