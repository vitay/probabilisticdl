  langid = {english},
  file = {/Users/vitay/Documents/Zotero/storage/3MANNM6W/Khalvati et al_2019_Modeling other minds.pdf;/Users/vitay/Documents/Zotero/storage/L79726J7/eaax8783.html}
}

@article{Khamassi2005,
