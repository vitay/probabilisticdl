@misc{Wu2022,
  title = {{{DayDreamer}}: {{World Models}} for {{Physical Robot Learning}}},
  shorttitle = {{{DayDreamer}}},
  author = {Wu, Philipp and Escontrela, Alejandro and Hafner, Danijar and Goldberg, Ken and Abbeel, Pieter},
  year = 2022,
