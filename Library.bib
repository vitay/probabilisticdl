  author = {Tuyls, Karl and Omidshafiei, Shayegan and Muller, Paul and Wang, Zhe and Connor, Jerome and Hennes, Daniel and Graham, Ian and Spearman, William and Waskett, Tim and Steele, Dafydd and Luc, Pauline and Recasens, Adria and Galashov, Alexandre and Thornton, Gregory and Elie, Romuald and Sprechmann, Pablo and Moreno, Pol and Cao, Kris and Garnelo, Marta and Dutta, Praneet and Valko, Michal and Heess, Nicolas and Bridgland, Alex and Perolat, Julien and De Vylder, Bart and Eslami, Ali and Rowland, Mark and Jaegle, Andrew and Munos, Remi and Back, Trevor and Ahamed, Razia and Bouton, Simon and Beauguerlange, Nathalie and Broshear, Jackson and Graepel, Thore and Hassabis, Demis},
  year = 2020,
