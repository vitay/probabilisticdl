@article{Lytton2017,
  title = {Multiscale Modeling in the Clinic: Diseases of the Brain and Nervous System},
  shorttitle = {Multiscale Modeling in the Clinic},
  author = {Lytton, William W. and Arle, Jeff and Bobashev, Georgiy and Ji, Songbai and Klassen, Tara L. and Marmarelis, Vasilis Z. and Schwaber, James and Sherif, Mohamed A. and Sanger, Terence D.},
