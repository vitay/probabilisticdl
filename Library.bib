  file = {/Users/vitay/Documents/Zotero/storage/CBAB4CKY/Nichol et al. - 2022 - GLIDE Towards Photorealistic Image Generation and Editing with Text-Guided Diffusion Models.pdf}
}

@article{Nicola2000,
  title = {Dopaminergic Modulation of Neuronal Excitability in the Striatum and Nucleus Accumbens.},
  author = {Nicola, S M and Surmeier, J and Malenka, R C},
  year = 2000,
  journal = {Annu Rev Neurosci},
  volume = {23},
  pages = {185--215},
  abstract = {The striatum and its ventral extension, the nucleus accumbens, are involved in behaviors as diverse as motor planning, drug seeking, and learning. Invariably, these striatally mediated behaviors depend on intact dopaminergic innervation. However, the mechanisms by which dopamine modulates neuronal function in the striatum and nucleus accumbens have been difficult to elucidate. Recent electrophysiological studies have revealed that dopamine alters both voltage-dependent conductances and synaptic transmission, resulting in state-dependent modulation of target cells. These studies make clear predictions about how dopamine, particularly via D1 receptor activation, should alter the responsiveness of striatal neurons to extrinsic excitatory synaptic activity.}
}

