@article{Feng2019,
  title = {{{MeshNet}}: {{Mesh Neural Network}} for {{3D Shape Representation}}},
  shorttitle = {{{MeshNet}}},
  author = {Feng, Yutong and Feng, Yifan and You, Haoxuan and Zhao, Xibin and Gao, Yue},
