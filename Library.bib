}

@misc{Hafner2022,
  title = {Mastering {{Atari}} with {{Discrete World Models}}},
  author = {Hafner, Danijar and Lillicrap, Timothy and Norouzi, Mohammad and Ba, Jimmy},
  year = 2022,
  month = feb,
  number = {arXiv:2010.02193},
