@article{Nachum2017,
  title = {Bridging the {{Gap Between Value}} and {{Policy Based Reinforcement Learning}}},
  author = {Nachum, Ofir and Norouzi, Mohammad and Xu, Kelvin and Schuurmans, Dale},
  year = 2017,
