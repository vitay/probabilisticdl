  primaryclass = {cs, stat},
  urldate = {2022-02-08},
  abstract = {Modelling interactions is critical in learning complex dynamical systems, namely systems of interacting objects with highly non-linear and time-dependent behaviour. A large class of such systems can be formalized as \$\textbackslash textit\textbraceleft geometric graphs\textbraceright\$, \$\textbackslash textit\textbraceleft i.e.\textbraceright\$, graphs with nodes positioned in the Euclidean space given an \$\textbackslash textit\textbraceleft arbitrarily\textbraceright\$ chosen global coordinate system, for instance vehicles in a traffic scene. Notwithstanding the arbitrary global coordinate system, the governing dynamics of the respective dynamical systems are invariant to rotations and translations, also known as \$\textbackslash textit\textbraceleft Galilean invariance\textbraceright\$. As ignoring these invariances leads to worse generalization, in this work we propose local coordinate frames per node-object to induce roto-translation invariance to the geometric graph of the interacting dynamical system. Further, the local coordinate frames allow for a natural definition of anisotropic filtering in graph neural networks. Experiments in traffic scenes, 3D motion capture, and colliding particles demonstrate that the proposed approach comfortably outperforms the recent state-of-the-art.},
  archiveprefix = {arXiv},
  file = {/Users/vitay/Documents/Zotero/storage/H95S3WNW/Kofinas_et_al_2021_Roto-translated_Local_Coordinate_Frames_For_Interacting_Dynamical_Systems.pdf;/Users/vitay/Documents/Zotero/storage/KL3EUQBI/2110.html}
