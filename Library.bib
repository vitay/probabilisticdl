}

@article{LeGoff2021,
  title = {Monitoring the {{Greater Agulhas Current With AIS Data Information}}},
  author = {Le Goff, Cl{\'e}ment and Boussidi, Brahim and Mironov, Alexei and Guichoux, Yann and Zhen, Yicun and Tandeo, Pierre and Gueguen, Simon and Chapron, Bertrand},
  year = 2021,
  journal = {Journal of Geophysical Research: Oceans},
  volume = {126},
