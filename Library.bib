@article{Ito2006,
  title = {Selective Excitotoxic Lesions of the Hippocampus and Basolateral Amygdala Have Dissociable Effects on Appetitive Cue and Place Conditioning Based on Path Integration in a Novel {{Y}}-Maze Procedure.},
  author = {Ito, Rutsuko and Robbins, Trevor W and McNaughton, Bruce L and Everitt, Barry J},
  year = 2006,
