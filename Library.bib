@misc{Kohl2024,
  title = {Benchmarking {{Autoregressive Conditional Diffusion Models}} for {{Turbulent Flow Simulation}}},
  author = {Kohl, Georg and Chen, Li-Wei and Thuerey, Nils},
  year = 2024,
  month = dec,
  number = {arXiv:2309.01745},
